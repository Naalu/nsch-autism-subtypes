{
  "name": "nsch-autism-subtypes-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The project website: the analysis as an interactive story, built as a static SvelteKit site from the committed data files.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "svelte-kit sync || echo ''"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/d3-quadtree": "3.0.6",
    "@types/node": "22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.8",
    "d3-quadtree": "3.0.1"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
