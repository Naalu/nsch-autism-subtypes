# Census files are downloaded by scripts/01_select.py; the processed table is committed.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Model outputs are regenerated by the pipeline. Commit a results snapshot deliberately, not by default.
results/*
results_k*/
results_ours*/
results_smoke*/
results_review*/
!results/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
